<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit your chats</title>
</head>
<body>
    <h3>Edit your chats<%=chat._id%></h3>
    <p>this chat was sent from <%=chat.from%> ti <%=chat.to%></p>
    <form  method="POST" action="/chats/<%=chat._id%>?_method=PUT">
        <textarea name="msg" rows="5" cols="5"><%=chat.msg%></textarea>
        <button>Edit</button>
    </form>
</body>
</html>