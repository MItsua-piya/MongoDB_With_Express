<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css">
    <title>Whatsapp</title>

</head>
<body>
    <h3>All Chast</h3>
   <form action="/chats/new" method="GET">
    <button type="submit">New Chat</button>
</form>


    <br>
    <%for( let chat of chats){%>
        <div class="chat">
            <p>From:<i><%=chat.from%></i></p>
             <div class="msg">
               <p><%=chat.msg%> <form  method="GET" action="/chats/<%=chat.id%>/edit"><button>Edit</button></form></p></div>
                <p>To:<i><%=chat.to%></i></p>
                <hr/>
                <p><i>Received by</i> <%=chat.created_at.toString().split(" ") [4]%></p>
                <p><i>Received by</i> <%=chat.created_at.toString().split(" ").slice(0,4).join(" ")%></p>
        </div>
        <br><br>

   <% }%>
</body>
</html>